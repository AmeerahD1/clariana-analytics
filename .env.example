# ============================================================
# LLM PROVIDER
# ============================================================
# "openai" or "gemini"
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
# Optional — sensible defaults are used if omitted:
#   openai -> gpt-4o-mini
#   gemini -> gemini-1.5-flash
LLM_MODEL=

# ============================================================
# WHITE-LABEL BRANDING — everything below is optional.
# Unset values fall back to the Clariana defaults in config/branding.py.
# For a new client, this is the only section you need to touch.
# ============================================================

# The name shown in the header, sidebar, and browser tab.
# Displayed as "{BRAND_CLIENT_NAME} {BRAND_PRODUCT_NAME}"
BRAND_CLIENT_NAME=Clariana
BRAND_PRODUCT_NAME=Analytics
BRAND_TAGLINE=AI-Powered Business Intelligence

# 1-2 character mark shown in a small badge when no logo image is set.
BRAND_MARK=C

# Optional: a hosted logo image (PNG/SVG URL). Leave blank to use BRAND_MARK.
BRAND_LOGO_URL=

# Browser tab icon (any single emoji).
BRAND_PAGE_ICON=📊

# Colour system — hex values. Defaults are Clariana's dark teal + cyan.
BRAND_DARK_COLOR=#0d2e3a
BRAND_DARK_COLOR_2=#0a2530
BRAND_PANEL_COLOR=#123c4a
BRAND_PRIMARY_COLOR=#00b4c8
BRAND_PRIMARY_LIGHT=#3dd6e8
BRAND_TEXT_COLOR=#E7F6F8

# Consultancy attribution shown in the sidebar footer and exported reports.
# Set BRAND_SHOW_POWERED_BY=false for a fully white-labelled client hand-off.
BRAND_POWERED_BY_NAME=Clariana
BRAND_POWERED_BY_URL=https://clariana.co.uk
BRAND_SHOW_POWERED_BY=true
